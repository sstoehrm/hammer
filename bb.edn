{:tasks
 {:requires ([babashka.fs :as fs]
             [babashka.http-client :as http]
             [clojure.edn :as edn]
             [clojure.java.io :as io]
             [clojure.string :as str])

  tokens
  {:doc "TodoMVC token count, hammer vs re-frame (pinned commit), comments stripped"
   :task (let [sha "1a1bf1df6570b17a148ebce70d500ec2da393cdc"
               base (str "https://raw.githubusercontent.com/day8/re-frame/" sha
                         "/examples/todomvc/src/todomvc/")
               strip (fn [s]
                       (->> (str/split-lines s)
                            (map (fn [line] (str/replace line (re-pattern "\\s*;.*$") "")))
                            (remove str/blank?)
                            (str/join "\n")))
               rf (str/join "\n" (for [f ["core" "db" "events" "subs" "views"]]
                                   (strip (:body (http/get (str base f ".cljs"))))))
               ours (strip (slurp "examples/todomvc/src/todomvc/core.cljs"))]
           (fs/create-dirs "target/tokens")
           (spit "target/tokens/re-frame.cljs" rf)
           (spit "target/tokens/hammer.cljs" ours)
           (shell "node scripts/count-tokens.cjs target/tokens/re-frame.cljs target/tokens/hammer.cljs"))}

  loc
  {:doc "Non-blank, non-comment lines in src/hammer"
   :task (let [n (->> (fs/glob "src/hammer" "*.{clj,cljs}")
                      (mapcat (fn [f] (str/split-lines (slurp (str f)))))
                      (map str/trim)
                      (remove (fn [line] (or (str/blank? line) (str/starts-with? line ";"))))
                      count)]
           (println "core LOC:" n))}

  sizes
  {:doc "Builds the dom/canvas/gpu size apps, prints raw and gzip sizes, and fails if a bundle contains another variant's namespaces"
   :task (let [forbidden {"size-dom" ["hammer/draw.cljs" "hammer/canvas.cljs" "hammer/gpu.cljs"]
                          "size-canvas" ["hammer/dom.cljs" "hammer/gpu.cljs"]
                          "size-gpu" ["hammer/dom.cljs" "hammer/canvas.cljs"]}
               out (fn [b] (str "target/size/" b "/main.js"))
               manifest (fn [b] (str "target/size/" b "/manifest.edn"))
               gz (fn [f] (let [bos (java.io.ByteArrayOutputStream.)]
                            (with-open [z (java.util.zip.GZIPOutputStream. bos)]
                              (io/copy (io/file f) z))
                            (.size bos)))
               sources (fn [b] (set (mapcat :sources (edn/read-string (slurp (manifest b))))))
               builds (sort (keys forbidden))]
           (apply shell "npx shadow-cljs release" builds)
           (let [bad (vec (for [b builds
                                :let [srcs (sources b)]
                                n (forbidden b) :when (contains? srcs n)]
                            [b n]))]
             (doseq [b builds]
               (println (format "%-12s %8d B  %7d B gzip" b (fs/size (out b)) (gz (out b)))))
             (when (seq bad)
               (println "FAIL: forbidden namespaces:" bad)
               (System/exit 1))))}

  bench-canvas
  {:doc "Canvas benchmark: release-builds bench-canvas/bench-dom/bench-gpu, checks their namespaces, runs bench/canvas/run.mjs (args pass through, e.g. bb bench-canvas --scenario table-1k --iterations 3)"
   :task (let [forbidden {"bench-canvas" ["hammer/dom.cljs" "hammer/core.cljs" "hammer/gpu.cljs"]
                          "bench-gpu" ["hammer/dom.cljs" "hammer/core.cljs" "hammer/canvas.cljs"]}
               sources (fn [b] (set (mapcat :sources (edn/read-string (slurp (str "target/bench/" b "/manifest.edn"))))))]
           (shell "npx shadow-cljs release bench-canvas bench-dom bench-gpu")
           (let [bad (vec (for [[b ns] forbidden n ns :when (contains? (sources b) n)] [b n]))]
             (when (seq bad)
               (println "FAIL: forbidden namespaces:" bad)
               (System/exit 1)))
           (apply shell "node bench/canvas/run.mjs" *command-line-args*))}}}
