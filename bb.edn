{:tasks
 {:requires ([babashka.fs :as fs]
             [clojure.edn :as edn]
             [clojure.java.io :as io]
             [clojure.string :as str])

  jar
  {:doc "Release jar: bb jar 0.1.0 (or v0.1.0) → target/hammer-0.1.0.jar"
   :task (shell "clojure -T:build jar :version" (pr-str (first *command-line-args*)))}

  release:check
  {:doc "Fails unless the tag (v0.1.0) is a plain semver version and both hammer-app plugin manifests carry its version"
   :task (let [t (first *command-line-args*)
               fail! (fn [& msg] (binding [*out* *err*] (apply println "release:check:" msg)) (System/exit 1))]
           (when-not (and t (re-matches (re-pattern "v\\d+\\.\\d+\\.\\d+(-[\\w.]+)?") t))
             (fail! "tag must look like v0.1.0, got" (pr-str t)))
           (let [v (subs t 1)
                 manifests ["plugins/hammer-app/.claude-plugin/plugin.json"
                            "plugins/hammer-app/.codex-plugin/plugin.json"]
                 wrong (for [m manifests
                             :let [mv (get (cheshire.core/parse-string (slurp m)) "version")]
                             :when (not= v mv)]
                         (str m " has " (pr-str mv)))]
             (when (seq wrong)
               (fail! (str "the plugin version must match the tag " t " (bb release:bump " v "):\n  "
                           (str/join "\n  " wrong)))))
           (println "release:check: ok" t))}

  release:bump
  {:doc "Sets the hammer-app plugin version in both manifests: bb release:bump 0.2.0 (then commit, merge, tag v0.2.0)"
   :task (let [v (first *command-line-args*)]
           (when-not (and v (re-matches (re-pattern "\\d+\\.\\d+\\.\\d+(-[\\w.]+)?") v))
             (binding [*out* *err*] (println "release:bump: version must look like 0.2.0, got" (pr-str v)))
             (System/exit 1))
           (doseq [m ["plugins/hammer-app/.claude-plugin/plugin.json"
                      "plugins/hammer-app/.codex-plugin/plugin.json"]]
             ;; replace the value only, so the file keeps its formatting
             (spit m (str/replace-first (slurp m) (re-pattern "\"version\": \"[^\"]*\"")
                                        (str "\"version\": \"" v "\"")))
             (println "release:bump:" m "→" v)))}

  loc
  {:doc "Non-blank, non-comment lines in src/hammer"
   :task (let [n (->> (fs/glob "src/hammer" "*.{clj,cljs}")
                      (mapcat (fn [f] (str/split-lines (slurp (str f)))))
                      (map str/trim)
                      (remove (fn [line] (or (str/blank? line) (str/starts-with? line ";"))))
                      count)]
           (println "core LOC:" n))}

  sizes
  {:doc "Builds the dom/canvas/gl size apps, prints raw and gzip sizes, and fails if a bundle contains another variant's namespaces"
   :task (let [forbidden {"size-dom" ["hammer/draw.cljs" "hammer/canvas.cljs" "hammer/gl.cljs"]
                          "size-canvas" ["hammer/dom.cljs" "hammer/gl.cljs"]
                          "size-gl" ["hammer/dom.cljs" "hammer/canvas.cljs"]}
               out (fn [b] (str "target/size/" b "/main.js"))
               manifest (fn [b] (str "target/size/" b "/manifest.edn"))
               gz (fn [f] (let [bos (java.io.ByteArrayOutputStream.)]
                            (with-open [z (java.util.zip.GZIPOutputStream. bos)]
                              (io/copy (io/file f) z))
                            (.size bos)))
               sources (fn [b] (set (mapcat :sources (edn/read-string (slurp (manifest b))))))
               builds (sort (keys forbidden))
               fail! (fn [msg] (binding [*out* *err*] (println "bb sizes:" msg)) (System/exit 1))]
           (try
             (apply shell "npx shadow-cljs release" builds)
             (catch Exception e
               (fail! (str "shadow-cljs release failed"
                           (when-let [x (or (:exit (ex-data e)) (some-> (:proc (ex-data e)) deref :exit))] (str " (exit " x ")"))
                           "; see its output above"))))
           (doseq [b builds :when (not (fs/exists? (manifest b)))]
             (fail! (str "missing " (manifest b) " (did the " b " build run?)")))
           (let [bad (vec (for [b builds
                                :let [srcs (sources b)]
                                n (forbidden b) :when (contains? srcs n)]
                            [b n]))]
             (doseq [b builds]
               (println (format "%-12s %8d B  %7d B gzip" b (fs/size (out b)) (gz (out b)))))
             (when (seq bad)
               (println "FAIL: forbidden namespaces:" bad)
               (System/exit 1))))}

  bench-canvas
  {:doc "Canvas benchmark: release-builds bench-canvas/bench-dom/bench-gl, checks their namespaces, runs bench/canvas/run.mjs (args pass through, e.g. bb bench-canvas --scenario table-1k --iterations 3)"
   :task (let [forbidden {"bench-canvas" ["hammer/dom.cljs" "hammer/core.cljs" "hammer/gl.cljs"]
                          "bench-gl" ["hammer/dom.cljs" "hammer/core.cljs" "hammer/canvas.cljs"]}
               builds ["bench-canvas" "bench-dom" "bench-gl"]
               manifest (fn [b] (str "target/bench/" b "/manifest.edn"))
               sources (fn [b] (set (mapcat :sources (edn/read-string (slurp (manifest b))))))
               fail! (fn [msg] (binding [*out* *err*] (println "bb bench-canvas:" msg)) (System/exit 1))]
           (try
             (apply shell "npx shadow-cljs release" builds)
             (catch Exception e
               (fail! (str "shadow-cljs release failed"
                           (when-let [x (or (:exit (ex-data e)) (some-> (:proc (ex-data e)) deref :exit))] (str " (exit " x ")"))
                           "; see its output above"))))
           (doseq [b builds :when (not (fs/exists? (manifest b)))]
             (fail! (str "missing " (manifest b) " (did the " b " build run?)")))
           (let [bad (vec (for [[b ns] forbidden n ns :when (contains? (sources b) n)] [b n]))]
             (when (seq bad)
               (println "FAIL: forbidden namespaces:" bad)
               (System/exit 1)))
           (apply shell "node bench/canvas/run.mjs" *command-line-args*))}}}
