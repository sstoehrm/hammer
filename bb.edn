{:tasks
 {:requires ([babashka.fs :as fs]
             [babashka.http-client :as http]
             [clojure.string :as str])

  tokens
  {:doc "TodoMVC token count, cljs-ui vs re-frame (pinned commit), comments stripped"
   :task (let [sha "1a1bf1df6570b17a148ebce70d500ec2da393cdc"
               base (str "https://raw.githubusercontent.com/day8/re-frame/" sha
                         "/examples/todomvc/src/todomvc/")
               strip (fn [s]
                       (->> (str/split-lines s)
                            (map (fn [line] (str/replace line (re-pattern "\\s*;.*$") "")))
                            (remove str/blank?)
                            (str/join "\n")))
               rf (str/join "\n" (for [f ["core" "db" "events" "subs" "views"]]
                                   (strip (:body (http/get (str base f ".cljs"))))))
               ours (strip (slurp "examples/todomvc/src/todomvc/core.cljs"))]
           (fs/create-dirs "target/tokens")
           (spit "target/tokens/re-frame.cljs" rf)
           (spit "target/tokens/cljs-ui.cljs" ours)
           (shell "node scripts/count-tokens.cjs target/tokens/re-frame.cljs target/tokens/cljs-ui.cljs"))}

  loc
  {:doc "Non-blank, non-comment lines in src/cljs_ui (target <= 800)"
   :task (let [n (->> (fs/glob "src/cljs_ui" "*.{clj,cljs}")
                      (mapcat (fn [f] (str/split-lines (slurp (str f)))))
                      (map str/trim)
                      (remove (fn [line] (or (str/blank? line) (str/starts-with? line ";"))))
                      count)]
           (println "core LOC:" n "(target <= 800)")
           (when (> n 800) (System/exit 1)))}}}
